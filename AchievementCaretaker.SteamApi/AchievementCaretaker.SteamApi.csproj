<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Achievement Caretaker Steam API</AssemblyTitle>
    <Company>Yaroslav V Tatarenko</Company>
    <Authors>Yaroslav V Tatarenko</Authors>
    <Description>Native Steam client interop for Achievement Caretaker. Based on Steam Achievement Manager by Rick (gibbed).</Description>
    <Copyright>Copyright © 2026 Yaroslav V Tatarenko. Based on Steam Achievement Manager, copyright © 2008-2024 Rick (gibbed).</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/yartat/AchievementCaretaker/</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Plain net10.0, not net10.0-windows: the interop is written against
         NativeLibrary rather than kernel32, and the registry lookup is guarded
         by OperatingSystem.IsWindows(). Microsoft.Win32.Registry is part of the
         shared framework here, so no package reference is needed. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;AnyCPU</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>True</Optimize>
  </PropertyGroup>
</Project>
