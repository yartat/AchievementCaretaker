# Template for packaging/winget/build.sh, which fills in the @...@ fields.
PackageIdentifier: yartat.AchievementCaretaker
PackageVersion: @VERSION@
PackageLocale: en-US
Publisher: Yaroslav V Tatarenko
PublisherUrl: https://github.com/yartat
PublisherSupportUrl: https://github.com/yartat/AchievementCaretaker/issues
PrivacyUrl: https://github.com/yartat/AchievementCaretaker/blob/main/PRIVACY.md
PackageName: Achievement Caretaker
PackageUrl: https://github.com/yartat/AchievementCaretaker
License: MIT and zlib
LicenseUrl: https://github.com/yartat/AchievementCaretaker/blob/main/LICENSE.txt
Copyright: Copyright (c) 2026 Yaroslav V Tatarenko
ShortDescription: View and edit Steam achievements and statistics, and view Epic and GOG libraries and achievements.
Description: >-
  Achievement Caretaker is a portable desktop tool for the achievements and statistics of your games.
  Steam: the library, and the achievement and statistics editor. Steam must be running and you must be logged in.
  Epic Games and GOG: your libraries and achievements. Epic is read-only; GOG achievements can be unlocked and locked.
Tags:
  - steam
  - achievements
  - gog
  - epic
  - games
ReleaseNotesUrl: https://github.com/yartat/AchievementCaretaker/releases/tag/v@VERSION@
ManifestType: defaultLocale
ManifestVersion: 1.12.0
