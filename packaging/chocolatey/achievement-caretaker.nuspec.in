<?xml version="1.0" encoding="utf-8"?>
<!--
  AchievementCaretaker
  Copyright (c) 2026 Yaroslav V Tatarenko

  See LICENSE in the repository root.

  Template for packaging/chocolatey/build.sh, which fills in the @...@ fields.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>achievement-caretaker</id>
    <version>@VERSION@</version>
    <title>Achievement Caretaker</title>
    <authors>Yaroslav V Tatarenko</authors>
    <owners>Yaroslav V Tatarenko</owners>
    <projectUrl>https://github.com/yartat/AchievementCaretaker</projectUrl>
    <projectSourceUrl>https://github.com/yartat/AchievementCaretaker</projectSourceUrl>
    <packageSourceUrl>https://github.com/yartat/AchievementCaretaker/tree/main/packaging/chocolatey</packageSourceUrl>
    <bugTrackerUrl>https://github.com/yartat/AchievementCaretaker/issues</bugTrackerUrl>
    <docsUrl>https://github.com/yartat/AchievementCaretaker/blob/main/README.md</docsUrl>
    <licenseUrl>https://github.com/yartat/AchievementCaretaker/blob/main/LICENSE.txt</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>Copyright (c) 2026 Yaroslav V Tatarenko</copyright>
    <tags>steam achievements gog epic games library achievement-manager</tags>
    <summary>View and edit Steam achievements and statistics, and view Epic and GOG libraries and achievements.</summary>
    <description>Achievement Caretaker is a portable desktop tool for the achievements and statistics of your games.

Steam: the library, and the achievement and statistics editor. Steam must be running and you must be logged in. The library opens without it and shows the games saved last time.

Epic Games and GOG: your libraries and achievements. Epic is read-only; GOG achievements can be unlocked and locked. Signing in happens on the store's own page, inside the application.

Based on Steam Achievement Manager by Rick (gibbed), distributed under the zlib license, and on GOG Achievements Manager by Timendum. See the project's README for the full attribution.</description>
    <releaseNotes>https://github.com/yartat/AchievementCaretaker/releases/tag/v@VERSION@</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
