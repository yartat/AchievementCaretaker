[Desktop Entry]
Type=Application
Version=1.0
Name=Achievement Caretaker
GenericName=Steam achievement manager
Comment=Manage achievements and statistics for games in your Steam library
Exec=achievement-caretaker
Icon=achievement-caretaker
Terminal=false
Categories=Game;
Keywords=Steam;achievement;achievements;statistics;
StartupNotify=true
StartupWMClass=AchievementCaretaker
