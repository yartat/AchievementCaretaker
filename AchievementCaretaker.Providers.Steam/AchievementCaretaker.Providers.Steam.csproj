<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Achievement Caretaker Providers.Steam</AssemblyTitle>
    <Description>Steam as a store provider for Achievement Caretaker: the client side of the helper process that talks to Steam. Based on Steam Achievement Manager by Rick (gibbed).</Description>
    <Copyright>Copyright © 2026 Yaroslav V Tatarenko. Steam support based on Steam Achievement Manager, copyright © 2008-2024 Rick (gibbed).</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\steam_worker.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="$(Protobuf)" />
    <PackageReference Include="Grpc.Net.Client" Version="$(Grpc)" />
    <PackageReference Include="Grpc.Tools" Version="$(Grpc)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AchievementCaretaker.Providers.Abstractions\AchievementCaretaker.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\AchievementCaretaker.SteamApi\AchievementCaretaker.SteamApi.csproj" />
  </ItemGroup>

</Project>