<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Achievement Caretaker Providers</AssemblyTitle>
    <Company>Yaroslav V Tatarenko</Company>
    <Authors>Yaroslav V Tatarenko</Authors>
    <Description>Read-only library and achievement access for Epic Games and GOG, for Achievement Caretaker. GOG support is based on GOG Achievements Manager by Timendum.</Description>
    <Copyright>Copyright © 2026 Yaroslav V Tatarenko. GOG support based on GOG Achievements Manager by Timendum.</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/yartat/AchievementCaretaker/</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
  <PropertyGroup>
    <!-- No native code and no package references: everything here is HTTPS
         plus System.Text.Json, which ship with the shared framework. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;AnyCPU</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>True</Optimize>
  </PropertyGroup>
</Project>
