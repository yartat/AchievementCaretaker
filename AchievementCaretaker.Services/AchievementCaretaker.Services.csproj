<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Achievement Caretaker Services</AssemblyTitle>
    <Description>The logic behind the windows of Achievement Caretaker, without a user interface: the library and achievement caches and the services that use them. The Steam half is based on Steam Achievement Manager by Rick (gibbed).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="$(Dapper)" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(Net10x)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(Net10x)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(Net10x)" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SqlLite)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AchievementCaretaker.Providers.Abstractions\AchievementCaretaker.Providers.Abstractions.csproj" />
  </ItemGroup>

</Project>
