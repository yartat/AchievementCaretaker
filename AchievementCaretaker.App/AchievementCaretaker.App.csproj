<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(Platform)'=='x86'">..\bin\x86\</OutputPath>
    <OutputPath Condition="'$(OutputPath)'=='' and '$(RuntimeIdentifier)'!=''">..\bin\$(RuntimeIdentifier)\</OutputPath>
    <OutputPath Condition="'$(OutputPath)'==''">..\bin\</OutputPath>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Achievement Caretaker</AssemblyTitle>
    <Description>A single-executable manager for game achievements and stats. Steam support is based on Steam Achievement Manager by Rick (gibbed); GOG support is based on GOG Achievements Manager by Timendum.</Description>
    <Copyright>Copyright © 2026 Yaroslav V Tatarenko. Steam support based on Steam Achievement Manager, copyright © 2008-2024 Rick (gibbed); GOG support based on GOG Achievements Manager by Timendum.</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>AchievementCaretaker</AssemblyName>
    <RootNamespace>AchievementCaretaker.App</RootNamespace>
    <ApplicationIcon>Resources\AchievementCaretaker.ico</ApplicationIcon>
    <!-- The manifest only means anything to the Windows loader. -->
    <ApplicationManifest Condition="'$(RuntimeIdentifier)'=='' or $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Pinning a RID is what keeps bin\ from filling with every platform's
       native Skia/HarfBuzz. Without one, a framework-dependent build copies
       every RID's native assets that Avalonia and Skia ship - Linux, musl,
       macOS, Android, riscv - which came to over 500 MB and made the release
       artifact useless. -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Platform)'=='x86' and $([MSBuild]::IsOSPlatform('Windows'))">win-x86</RuntimeIdentifier>
    <!-- Default to the host's own RID, not a hardcoded win-x64: an explicit -r
         on the command line still wins, but a plain `dotnet build` on Linux or
         macOS must produce an apphost for *that* machine. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(Avalonia)" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="$(AvaloniaItemsRepeater)" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaWebView)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(Avalonia)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(Avalonia)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaDataGrid)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="$(AvaloniaUIDiagnosticsSupport)" Condition="'$(Configuration)'=='Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvm)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(Net10x)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AchievementCaretaker.SteamApi\AchievementCaretaker.SteamApi.csproj" />
    <ProjectReference Include="..\AchievementCaretaker.Services\AchievementCaretaker.Services.csproj" />
    <ProjectReference Include="..\AchievementCaretaker.Providers.Steam.Worker\AchievementCaretaker.Providers.Steam.Worker.csproj" />
    <ProjectReference Include="..\AchievementCaretaker.Providers.Abstractions\AchievementCaretaker.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\AchievementCaretaker.Providers.Epic\AchievementCaretaker.Providers.Epic.csproj" />
    <ProjectReference Include="..\AchievementCaretaker.Providers.Gog\AchievementCaretaker.Providers.Gog.csproj" />
  </ItemGroup>

</Project>
