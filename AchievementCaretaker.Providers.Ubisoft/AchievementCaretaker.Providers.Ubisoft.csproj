<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Achievement Caretaker Providers.Ubisoft</AssemblyTitle>
    <Description>Library and achievement access for Ubisoft Connect, read from its local files and Ubisoft's public CDN, for Achievement Caretaker. Based on UbiSlot by BalTor02, Achievements by PSerban93, galaxy-integration-uplay by melcom and UplayKit by UplayDB.</Description>
    <Copyright>Copyright © 2026 Yaroslav V Tatarenko. Ubisoft support based on UbiSlot by BalTor02, Achievements by PSerban93, galaxy-integration-uplay by melcom and UplayKit by UplayDB.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(Net10x)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(Net10x)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AchievementCaretaker.Providers.Abstractions\AchievementCaretaker.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\AchievementCaretaker.Providers.Shared\AchievementCaretaker.Providers.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\UplayGames.txt" LogicalName="UplayGames.txt" />
  </ItemGroup>

</Project>
