<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Achievement Caretaker Providers.Epic</AssemblyTitle>
    <Company>Yaroslav V Tatarenko</Company>
    <Authors>Yaroslav V Tatarenko</Authors>
    <Description>Read-only library and achievement access for Epic Games, for Achievement Caretaker.</Description>
    <Copyright>Copyright © 2026 Yaroslav V Tatarenko.</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <Version>2.1.1</Version>
    <AssemblyVersion>2.1.1.0</AssemblyVersion>
    <FileVersion>2.1.1.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/yartat/AchievementCaretaker/</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AchievementCaretaker.Providers.Abstractions\AchievementCaretaker.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\AchievementCaretaker.Providers.Shared\AchievementCaretaker.Providers.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>True</Optimize>
  </PropertyGroup>
</Project>
