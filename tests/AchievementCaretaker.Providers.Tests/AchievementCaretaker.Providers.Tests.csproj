<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Tests of the public surface of the store providers. They reference the projects like
         any other consumer would, so nothing here depends on InternalsVisibleTo. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;AnyCPU</Platforms>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AchievementCaretaker.Providers.Abstractions\AchievementCaretaker.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\..\AchievementCaretaker.Providers.Shared\AchievementCaretaker.Providers.Shared.csproj" />
    <ProjectReference Include="..\..\AchievementCaretaker.Providers.Epic\AchievementCaretaker.Providers.Epic.csproj" />
    <ProjectReference Include="..\..\AchievementCaretaker.Providers.Gog\AchievementCaretaker.Providers.Gog.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
