<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Tests of the Steam provider and its helper's server, over a real loopback TLS connection
         with a fake backend, so no Steam is needed. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;AnyCPU</Platforms>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AchievementCaretaker.Providers.Steam.Worker\AchievementCaretaker.Providers.Steam.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
